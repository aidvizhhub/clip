#!/usr/bin/env bash
# clip — сниппеты из ~/clip в буфер обмена.
#
#   clip              выбрать файл из меню и скопировать в буфер
#   clip all          склеить все файлы папки в буфер (по алфавиту)
#   clip last         скопировать самый свежий файл (без меню)
#   clip 2            скопировать файл №2 из списка (свежие сверху)
#   clip имя.txt      скопировать конкретный файл по имени
#   clip save [имя]   сохранить содержимое буфера в новый файл (clip-ДАТА.txt)
#
# Папка по умолчанию: ~/clip (меняется через CLIP_DIR).
set -euo pipefail

DIR="${CLIP_DIR:-$HOME/clip}"
mkdir -p "$DIR"

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a clip "$1" "$2" 2>/dev/null || true; }

to_clip() {
  if command -v wl-copy >/dev/null 2>&1; then wl-copy
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard
  else echo "clip: нет wl-copy или xclip" >&2; exit 1; fi
}

from_clip() {
  if command -v wl-paste >/dev/null 2>&1; then wl-paste --no-newline
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard -o
  else echo "clip: нет wl-paste или xclip" >&2; exit 1; fi
}

if [ "${1:-}" = "save" ]; then
  name="${2:-clip-$(date +%Y%m%d-%H%M%S).txt}"
  from_clip > "$DIR/$name"
  notify "clip" "сохранено: $name"
  exit 0
fi

if [ "${1:-}" = "all" ]; then
  mapfile -t allf < <(find "$DIR" -maxdepth 1 -type f ! -name '.*' | sort)
  if [ "${#allf[@]}" -eq 0 ]; then notify "clip" "папка пуста: $DIR"; exit 0; fi
  { for f in "${allf[@]}"; do cat "$f"; printf '\n'; done; } | to_clip
  notify "clip" "склеено файлов: ${#allf[@]}"
  exit 0
fi

# файлы папки, свежие сверху
mapfile -t files < <(find "$DIR" -maxdepth 1 -type f ! -name '.*' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)

if [ "${#files[@]}" -eq 0 ]; then
  notify "clip" "папка пуста: $DIR"
  exit 0
fi

sel="${1:-}"
if [ "$sel" = "last" ]; then
  f="${files[0]}"
elif [[ "$sel" =~ ^[0-9]+$ ]]; then
  if [ "$sel" -lt 1 ] || [ "$sel" -gt "${#files[@]}" ]; then notify "clip" "нет файла №$sel"; exit 1; fi
  f="${files[$((sel - 1))]}"
elif [ -n "$sel" ]; then
  f="$DIR/$sel"
  [ -f "$f" ] || { notify "clip" "не нашёл: $sel"; exit 1; }
else
  if [ "${#files[@]}" -eq 1 ]; then
    f="${files[0]}"
  else
    if command -v zenity >/dev/null 2>&1; then
      names=(); for p in "${files[@]}"; do names+=("$(basename "$p")"); done
      pick=$(zenity --list --title="clip → буфер" --text="что скопировать в буфер?" --column="файл" "★ всё содержимое (Ctrl+Alt+A)" "${names[@]}" --width=420 --height=360) || exit 0
    elif command -v rofi >/dev/null 2>&1; then
      pick=$(printf '%s\n' "★ всё содержимое (Ctrl+Alt+A)" "${files[@]}" | rofi -dmenu -i -p "clip") || exit 0
    else
      notify "clip" "нет zenity/rofi для меню"
      exit 1
    fi
    [ -n "${pick:-}" ] || exit 0
    if [ "$pick" = "★ всё содержимое (Ctrl+Alt+A)" ]; then
      { for f in "${files[@]}"; do cat "$f"; printf '\n'; done; } | to_clip
      notify "clip" "склеено файлов: ${#files[@]}"
      exit 0
    fi
    if [[ "$pick" = /* ]]; then f="$pick"; else f="$DIR/$pick"; fi
  fi
fi

to_clip < "$f"
notify "clip" "скопировано: $(basename "$f")"
