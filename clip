#!/usr/bin/env bash
# clip — сниппеты из ~/clip в буфер обмена.
#
#   clip              меню: файлы и папки из ~/clip → в буфер
#   clip all          склеить ВСЁ (включая подпапки) в буфер
#   clip last         самый свежий файл без меню
#   clip 2            элемент №2 из списка меню (папки, потом файлы)
#   clip имя          файл по имени; папка — склеит всё её содержимое
#   clip save [имя]   сохранить содержимое буфера в новый файл (clip-ДАТА.txt)
#
# Папка по умолчанию: ~/clip (меняется через CLIP_DIR).
set -euo pipefail

DIR="${CLIP_DIR:-$HOME/clip}"
mkdir -p "$DIR"

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a clip "$1" "$2" 2>/dev/null || true; }

to_clip() {
  if command -v wl-copy >/dev/null 2>&1; then wl-copy
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard
  else echo "clip: нет wl-copy или xclip" >&2; exit 1; fi
}

from_clip() {
  if command -v wl-paste >/dev/null 2>&1; then wl-paste --no-newline
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard -o
  else echo "clip: нет wl-paste или xclip" >&2; exit 1; fi
}

# все файлы под папкой: рекурсивно, по алфавиту, без скрытых
list_files() { find "$1" -type f ! -name '.*' | sort; }

# склеить файлы (или содержимое папки целиком) в буфер
copy_paths() {
  local files=() f p
  for p in "$@"; do
    if [ -d "$p" ]; then
      while IFS= read -r f; do files+=("$f"); done < <(list_files "$p")
    else
      files+=("$p")
    fi
  done
  if [ "${#files[@]}" -eq 0 ]; then notify "clip" "нечего копировать"; return 0; fi
  { for f in "${files[@]}"; do cat "$f"; printf '\n'; done; } | to_clip
}

if [ "${1:-}" = "save" ]; then
  name="${2:-clip-$(date +%Y%m%d-%H%M%S).txt}"
  from_clip > "$DIR/$name"
  notify "clip" "сохранено: $name"
  exit 0
fi

# элементы: папки (по алфавиту) + файлы корня (свежие сверху)
mapfile -t dirs  < <(find "$DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sort)
mapfile -t files < <(find "$DIR" -mindepth 1 -maxdepth 1 -type f ! -name '.*' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)

if [ "${#dirs[@]}" -eq 0 ] && [ "${#files[@]}" -eq 0 ]; then
  notify "clip" "пусто: $DIR — кидай файлы и папки сюда"
  exit 0
fi

sel="${1:-}"
case "$sel" in
  all)
    copy_paths "$DIR"
    notify "clip" "скопировано всё из $(basename "$DIR")"
    exit 0 ;;
  last)
    if [ "${#files[@]}" -eq 0 ]; then notify "clip" "в корне файлов нет, только папки"; exit 0; fi
    copy_paths "${files[0]}"
    notify "clip" "скопировано: $(basename "${files[0]}")"
    exit 0 ;;
esac

# нумерация как в меню: сначала папки, потом файлы
elements=("${dirs[@]}" "${files[@]}")
if [[ "$sel" =~ ^[0-9]+$ ]]; then
  if [ "$sel" -lt 1 ] || [ "$sel" -gt "${#elements[@]}" ]; then notify "clip" "нет элемента №$sel"; exit 1; fi
  p="${elements[$((sel - 1))]}"
  copy_paths "$p"
  notify "clip" "скопировано: $(basename "$p")"
  exit 0
fi
if [ -n "$sel" ]; then
  p="$DIR/$sel"
  if [ -f "$p" ] || [ -d "$p" ]; then
    copy_paths "$p"
    notify "clip" "скопировано: $sel"
    exit 0
  fi
  notify "clip" "не нашёл: $sel"
  exit 1
fi

# интерактив: меню из папок и файлов
labels=()
for p in "${dirs[@]}"; do labels+=("$(basename "$p")/"); done
for p in "${files[@]}"; do labels+=("$(basename "$p")"); done
hint="откуда: ${DIR/#$HOME/~} — кидай файлы и папки сюда; выбор папки = склеить её содержимое"

if [ "${#elements[@]}" -eq 1 ]; then
  choice="${labels[0]}"
else
  if command -v zenity >/dev/null 2>&1; then
    choice=$(zenity --list --title="clip → буфер" --text="$hint" --column="файл или папка" "★ всё содержимое (Ctrl+Alt+A)" "${labels[@]}" --width=480 --height=420) || exit 0
  elif command -v rofi >/dev/null 2>&1; then
    choice=$(printf '%s\n' "★ всё содержимое (Ctrl+Alt+A)" "${labels[@]}" | rofi -dmenu -i -p "clip") || exit 0
  else
    notify "clip" "нет zenity/rofi для меню"
    exit 1
  fi
  [ -n "${choice:-}" ] || exit 0
fi

if [ "$choice" = "★ всё содержимое (Ctrl+Alt+A)" ]; then
  copy_paths "$DIR"
  notify "clip" "скопировано всё из $(basename "$DIR")"
  exit 0
fi

if [[ "$choice" == */ ]]; then
  p="$DIR/${choice%/}"
else
  p="$DIR/$choice"
fi
if [ -f "$p" ] || [ -d "$p" ]; then
  copy_paths "$p"
  notify "clip" "скопировано: $(basename "$p")"
else
  notify "clip" "не нашёл: $choice"
  exit 1
fi
